<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Contacts"
        xmlns:viewModel="clr-namespace:ViewModel" x:Class="Contacts.MainWindow"
        mc:Ignorable="d"
        Title="Contacts" Height="450" Width="600" MinWidth="600" MinHeight="450">
    <Window.Resources>
        <viewModel:BoolToVisibilityConverterVM x:Key="BoolToVisibilityConverterVM"/>
    </Window.Resources>
    <Window.DataContext>
        <viewModel:MainVM/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="150" />
            <ColumnDefinition Width="3" />
            <!-- GridSplitter -->
            <ColumnDefinition Width="3*" MinWidth="250" />
        </Grid.ColumnDefinitions>

        <!-- Left Column -->
        <StackPanel Grid.Column="0" Background="#f8f8f8" Margin="15,15,3,15" >
            <StackPanel Orientation ="Horizontal">
                <TextBlock Text="Find:"></TextBlock>
                <TextBox Margin="3" Width="183" />
            </StackPanel>
            <ListBox Margin="3" Height="300" VerticalAlignment="Bottom" ItemsSource="{Binding Contacts}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedContact, Mode=TwoWay}">
                <!-- Другие элементы -->
            </ListBox>
            <StackPanel Orientation="Horizontal" Margin="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Content="Add" Height="25" Width="57" Margin="3" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding AddCommand}"/>
                <Button Content="Edit" Height="25" Width="57" Margin="3" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding EditCommand}" IsEnabled="{Binding CanEdit}"/>
                <Button Content="Remove" Height="25" Width="57" Margin="3" RenderTransformOrigin="2.28,0.723" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding RemoveCommand}" IsEnabled="{Binding CanRemove}"/>
            </StackPanel>
        </StackPanel>

        <!-- GridSplitter -->
        <GridSplitter Grid.Column="1" Width="3" Background="White" HorizontalAlignment="Stretch" />

        <!-- Right Column -->
        <StackPanel Grid.Column="2" Background="White" Margin="8">
            <Grid Margin="3,15,15,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Width="100" Height="100" Margin="3" Grid.Column="0" />
                <StackPanel Grid.Column="1" Margin="3">
                    <TextBlock Text="Name:" />
                    <TextBox Margin="3" Text="{Binding SelectedContact.Name, Mode=TwoWay}" IsEnabled="{Binding IsEditing}"/>
                    <TextBlock Text="Phone Number:" />
                    <TextBox Margin="3" Text="{Binding SelectedContact.PhoneNumber, Mode=TwoWay}" IsEnabled="{Binding IsEditing}"/>
                    <TextBlock Text="Email:" />
                    <TextBox  Margin="3" Text="{Binding SelectedContact.Email, Mode=TwoWay}" IsEnabled="{Binding IsEditing}"/>
                </StackPanel>
            </Grid>
            <Button Content="Apply" Width="75" Height="25" Margin="3" VerticalAlignment="Top" Command="{Binding ApplyCommand}" Visibility="{Binding CanApply, Converter={StaticResource BoolToVisibilityConverterVM}}" IsEnabled="True"/>
        </StackPanel>
    </Grid>
</Window>